# All necessary .gitignore entries must remain in sync with the parent repo.

# Ignored directories

# Top-level build artifacts (mirrors .gitignore from parent)
build/
*.o
*.so
*.a
*.exe
*.dll

# C++ artifacts
obj/
dist/

# Temporary build directories
_build/
build-*

# Downloaded assets and third-party libs
third_party/*/

# Plugin distribution
tmp*

# Packaged artifacts
*.rpm
*.deb
*.tar.xz

# IDE and editor artifacts
.vscode/
.idea/
*.swp
*.swo
*~

# Generated documentation and metadata
doc/
*.html
*.css
*.js

# Qt-specific artifacts
qmldir

# Log files
*.log

# Test artifacts
tests/.coverage-baseline.json
tests/fixtures/*

# OS-specific
.DS_Store
Thumbs.db

# Hardware
*.vkex
sys_*_driver.so

# User preferences
.kcfg/*

# Package manager cache
*.deb.src
*.orig
*.rej

# Distribution
dist/

# Ensure submodules remain consistent
/src/backend_scene/"